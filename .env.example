DATABASE_URL=postgres://dev_news:dev_news@localhost:5433/dev_news
TEST_DATABASE_URL=postgres://dev_news:dev_news@localhost:5433/dev_news_test
# For github-trending: a token with no scopes lifts the REST API limit from 60 to 5,000 calls an hour.
# Without it one ingest (about 30 calls) still works, but only once or twice an hour.
GITHUB_TOKEN=
# pnpm ingest calls REVALIDATE_URL/api/revalidate with this secret so cached pages refresh.
# In production: set REVALIDATE_SECRET on Vercel and in GitHub Actions secrets, REVALIDATE_URL as an Actions variable.
REVALIDATE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
